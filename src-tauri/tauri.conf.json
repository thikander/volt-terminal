{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Volt Terminal",
  "version": "0.1.3",
  "identifier": "com.voltterminal.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Volt Terminal",
        "width": 1100,
        "height": 720,
        "minWidth": 480,
        "minHeight": 320,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxOTNGOTA4NTdCODQwNEYKUldSUFFMaFhDUG1UY2MxWFcxOHJhblZxRDJUejF5UTkvQkhxaWhEb09VZzlZWTgyN1N0RHJ2L0wK",
      "endpoints": [
        "https://github.com/thikander/volt-terminal/releases/latest/download/latest.json"
      ]
    }
  }
}
